@startuml Email_Service_Class_Diagram
!theme aws-orange
title Email Service - Detailed Class Architecture

package "Email Service Layer" {
    
    class EmailService {
        - sendgrid_api_key: str
        - from_email: str
        - from_name: str
        - smtp_host: str
        - smtp_port: int
        - smtp_username: str
        - smtp_password: str
        - jwt_secret: str
        - base_url: str
        - db_service: DatabaseService
        - retry_attempts: int
        - timeout_seconds: int
        
        + __init__(db_service: DatabaseService)
        + send_editor_notification(invoice_data, editor_email, editor_name, changes_summary) -> Dict
        + send_bauleiter_approval(invoice_data, bauleiter_email, editor_info) -> Dict
        + _send_via_sendgrid(to_email, to_name, subject, html_content) -> Dict
        + _send_via_smtp(to_email, to_name, subject, html_content) -> Dict
        + _generate_html_template(template_type, context) -> str
        + _generate_approval_token(invoice_id, action, user_email) -> str
        + _validate_approval_token(token) -> Dict
        + _log_email_attempt(email_data) -> str
        + _log_email_result(log_id, result) -> None
    }
    
    class HTMLTemplateGenerator {
        + EDITOR_NOTIFICATION_TEMPLATE: str
        + BAULEITER_APPROVAL_TEMPLATE: str
        
        + render_editor_notification(context: Dict) -> str
        + render_bauleiter_approval(context: Dict) -> str
        + _format_changes_summary(changes: List) -> str
        + _format_currency(amount: float) -> str
        + _format_timestamp(timestamp: datetime) -> str
    }
    
    class SecurityManager {
        - jwt_secret: str
        - token_expiry_days: int = 7
        
        + generate_jwt_token(payload: Dict) -> str
        + validate_jwt_token(token: str) -> Dict
        + create_approval_url(invoice_id, action, user_email) -> str
        + validate_approval_url(url: str) -> Dict
        + hash_sensitive_data(data: str) -> str
    }
    
    class EmailProvider {
        <<interface>>
        + send_email(to_email, subject, content) -> Dict
        + validate_credentials() -> bool
        + get_provider_name() -> str
    }
    
    class SendGridProvider {
        - api_key: str
        - client: SendGridAPIClient
        
        + send_email(to_email, subject, content) -> Dict
        + validate_credentials() -> bool
        + get_provider_name() -> str
        + _handle_sendgrid_response(response) -> Dict
    }
    
    class SMTPProvider {
        - host: str
        - port: int
        - username: str
        - password: str
        
        + send_email(to_email, subject, content) -> Dict
        + validate_credentials() -> bool
        + get_provider_name() -> str
        + _create_mime_message(to_email, subject, content) -> MIMEMultipart
    }
    
    class EmailAuditLogger {
        - db_service: DatabaseService
        
        + log_email_attempt(email_data: Dict) -> str
        + log_email_success(log_id: str, provider: str, message_id: str) -> None
        + log_email_failure(log_id: str, error: str, provider: str) -> None
        + get_email_history(invoice_id: str) -> List[Dict]
        + get_failed_emails(days: int = 7) -> List[Dict]
    }
}

package "Database Layer" {
    class DatabaseService {
        + insert(table: str, data: Dict) -> str
        + update(table: str, data: Dict, where: Dict) -> bool
        + select(table: str, where: Dict) -> List[Dict]
        + execute_raw_query(query: str, params: List) -> Any
    }
}

package "Configuration Layer" {
    class EmailConfig {
        + SENDGRID_API_KEY: str
        + FROM_EMAIL: str
        + FROM_NAME: str
        + SMTP_HOST: str
        + SMTP_PORT: int
        + SMTP_USERNAME: str
        + SMTP_PASSWORD: str
        + JWT_SECRET: str
        + BASE_URL: str
        + ENABLE_EMAIL_NOTIFICATIONS: bool
        + EMAIL_PROVIDER: str
        + EMAIL_RETRY_ATTEMPTS: int
        + EMAIL_TIMEOUT_SECONDS: int
        
        + load_from_env() -> EmailConfig
        + validate_config() -> bool
        + get_provider_config(provider: str) -> Dict
    }
}

' Relationships
EmailService --> HTMLTemplateGenerator : uses
EmailService --> SecurityManager : uses
EmailService --> EmailAuditLogger : uses
EmailService --> EmailProvider : uses
EmailService --> DatabaseService : depends on

EmailProvider <|-- SendGridProvider : implements
EmailProvider <|-- SMTPProvider : implements

EmailAuditLogger --> DatabaseService : uses
EmailService --> EmailConfig : configured by

SecurityManager --> EmailConfig : uses JWT secret

note right of EmailService
    **Core Responsibilities:**
    - Orchestrate email sending
    - Handle provider fallbacks
    - Manage security tokens
    - Audit all operations
    - Template rendering
    - Error handling & retries
end note

note right of SecurityManager
    **Security Features:**
    - JWT token generation/validation
    - Approval URL creation
    - Token expiry management
    - Data encryption/hashing
    - Anti-tampering protection
end note

note bottom of EmailAuditLogger
    **Audit Trail:**
    - Every email attempt logged
    - Success/failure tracking
    - Provider used
    - Timestamps
    - Error details
    - Performance metrics
end note

@enduml
