# OCR Invoice Processor - Environment Configuration Example
# Copy this file to .env and update with your actual values

# Database Configuration
SUPA_URL=https://your-project.supabase.co
SUPA_SERVICE_ROLE_KEY=your-service-role-key-here
SUPA_ANON_KEY=your-anon-key-here

# PDF Storage Configuration
# Set to "true" to use mock storage for development, "false" for production Supabase storage
USE_MOCK_STORAGE=true

# API Configuration
API_BASE_URL=http://localhost:8000

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=noreply@yourcompany.com

# SMTP Configuration (fallback)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Environment
NODE_ENV=development

# Security
JWT_SECRET=your-jwt-secret-here

# Company Information
COMPANY_NAME=Your Company Name
COMPANY_EMAIL=info@yourcompany.com