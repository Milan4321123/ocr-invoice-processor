'use client'

import React, { useState, useEffect } from 'react'
import Link from 'next/link'
import { toast, Toaster } from 'react-hot-toast'
import { toastConfig } from '@/lib/toast-config'

// Skonto-focused types for Prüfbericht
interface SkontoInvoice {
  id: string
  filename: string
  vendor_name?: string
  total_amount?: number
  invoice_date?: string
  skonto_date?      <div className="mb-8">
        <div className="glass-card rounded-2xl p-8 shadow-2xl">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-4xl font-bold bg-gradient-to-r from-blue-600 via-purple-600 to-blue-800 bg-clip-text text-transparent mb-3">
                💎 Skonto Prüfbericht
              </h1>
              <p className="text-lg text-gray-600 font-medium">
                Monitor and optimize early payment discount opportunities with our advanced analytics dashboard
              </p>
              <div className="flex items-center mt-2 space-x-4">
                <span className="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                  🎯 Smart Analytics
                </span>
                <span className="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                  ⚡ Real-time Updates
                </span>
                <span className="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                  💰 Cost Savings
                </span>
              </div>
            </div>ng
  skonto_percentage?: number
  days_until_skonto?: number
  
  // Skonto tracking fields
  skonto_reminder_sent?: boolean
  skonto_reminder_sent_at?: string
  skonto_decision?: 'pending' | 'taken' | 'missed' | 'not_applicable'
  skonto_decision_at?: string
  skonto_decision_by?: string
  actual_skonto_savings?: number
  potential_skonto_savings?: number
}

interface SkontoMetrics {
  total_invoices_with_skonto: number
  total_potential_savings: number
  total_actual_savings: number
  total_missed_savings: number
  skonto_utilization_rate: number
  average_skonto_percentage: number
  upcoming_skonto_count: number
  upcoming_skonto_value: number
}

interface SkontoStats {
  pending: { count: number; total_amount: number; potential_savings: number; invoices: SkontoInvoice[] }
  taken: { count: number; total_amount: number; actual_savings: number; invoices: SkontoInvoice[] }
  missed: { count: number; total_amount: number; missed_savings: number; invoices: SkontoInvoice[] }
  expiring_soon: { count: number; total_amount: number; potential_savings: number; invoices: SkontoInvoice[] }
}

export default function PrufberichtPage() {
  const [skontoInvoices, setSkontoInvoices] = useState<SkontoInvoice[]>([])
  const [skontoMetrics, setSkontoMetrics] = useState<SkontoMetrics | null>(null)
  const [skontoStats, setSkontoStats] = useState<SkontoStats | null>(null)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [selectedTimeRange, setSelectedTimeRange] = useState<'7d' | '30d' | '90d' | 'all'>('30d')

  const apiUrl = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:8000'

  useEffect(() => {
    fetchSkontoData()
  }, [selectedTimeRange])

  const fetchSkontoData = async () => {
    try {
      setLoading(true)
      setError(null)

      // Fetch Skonto data using working endpoints
      const [
        skontoSummaryResponse,
        skontoOpportunitiesResponse
      ] = await Promise.all([
        fetch(`${apiUrl}/api/skonto/dashboard/summary`), // Working skonto summary endpoint
        fetch(`${apiUrl}/api/skonto/dashboard/opportunities`) // Working opportunities endpoint
      ])

      // Parse responses
      const [
        skontoSummaryData,
        skontoOpportunitiesData
      ] = await Promise.all([
        skontoSummaryResponse.ok ? skontoSummaryResponse.json() : null,
        skontoOpportunitiesResponse.ok ? skontoOpportunitiesResponse.json() : []
      ])

      // Set skonto invoices data from opportunities endpoint
      if (Array.isArray(skontoOpportunitiesData)) {
        const invoicesWithSkonto: SkontoInvoice[] = skontoOpportunitiesData.map((opportunity: any) => ({
          id: opportunity.id,
          filename: opportunity.invoice_number,
          vendor_name: opportunity.supplier,
          total_amount: opportunity.amount,
          skonto_date: opportunity.skonto_date,
          skonto_percentage: opportunity.skonto_percentage,
          days_until_skonto: opportunity.days_until_expiry,
          skonto_reminder_sent: opportunity.reminder_sent,
          skonto_decision: 'pending' as const, // From opportunities, these are all pending
          potential_skonto_savings: opportunity.potential_savings
        }))
        setSkontoInvoices(invoicesWithSkonto)
      }
      
      // Transform summary data to match our metrics interface
      if (skontoSummaryData) {
        const transformedMetrics: SkontoMetrics = {
          total_invoices_with_skonto: skontoSummaryData.total_opportunities || 0,
          total_potential_savings: skontoSummaryData.total_potential_savings || 0,
          total_actual_savings: skontoSummaryData.monthly_average_savings * 12 || 0, // Estimate annual from monthly
          total_missed_savings: 0, // Will calculate from opportunities data
          skonto_utilization_rate: skontoSummaryData.success_rate || 0,
          average_skonto_percentage: 2.0, // Default estimate
          upcoming_skonto_count: skontoSummaryData.urgent_count || 0,
          upcoming_skonto_value: skontoSummaryData.urgent_potential || 0
        }
        setSkontoMetrics(transformedMetrics)
      } else {
        // Fallback metrics if API doesn't return data
        const fallbackMetrics: SkontoMetrics = {
          total_invoices_with_skonto: 0,
          total_potential_savings: 0,
          total_actual_savings: 0,
          total_missed_savings: 0,
          skonto_utilization_rate: 0,
          average_skonto_percentage: 2.0,
          upcoming_skonto_count: 0,
          upcoming_skonto_value: 0
        }
        setSkontoMetrics(fallbackMetrics)
      }
      
      // Transform opportunities data to match our stats interface
      if (skontoOpportunitiesData && Array.isArray(skontoOpportunitiesData)) {
        const opportunities = skontoOpportunitiesData
        
        const stats: SkontoStats = {
          pending: {
            count: opportunities.filter(op => op.urgency_level === 'normal' && !op.reminder_sent).length,
            total_amount: opportunities.filter(op => op.urgency_level === 'normal').reduce((sum, op) => sum + (op.amount || 0), 0),
            potential_savings: opportunities.filter(op => op.urgency_level === 'normal').reduce((sum, op) => sum + (op.potential_savings || 0), 0),
            invoices: []
          },
          taken: {
            count: 0, // Will need separate endpoint for historical data
            total_amount: 0,
            actual_savings: 0,
            invoices: []
          },
          missed: {
            count: 0, // Will need separate endpoint for historical data
            total_amount: 0,
            missed_savings: 0,
            invoices: []
          },
          expiring_soon: {
            count: opportunities.filter(op => op.urgency_level === 'urgent' || op.days_until_expiry <= 3).length,
            total_amount: opportunities.filter(op => op.urgency_level === 'urgent').reduce((sum, op) => sum + (op.amount || 0), 0),
            potential_savings: opportunities.filter(op => op.urgency_level === 'urgent').reduce((sum, op) => sum + (op.potential_savings || 0), 0),
            invoices: []
          }
        }
        setSkontoStats(stats)
      } else {
        // Fallback stats if API doesn't return data
        const fallbackStats: SkontoStats = {
          pending: { count: 0, total_amount: 0, potential_savings: 0, invoices: [] },
          taken: { count: 0, total_amount: 0, actual_savings: 0, invoices: [] },
          missed: { count: 0, total_amount: 0, missed_savings: 0, invoices: [] },
          expiring_soon: { count: 0, total_amount: 0, potential_savings: 0, invoices: [] }
        }
        setSkontoStats(fallbackStats)
      }

      toast.success('Skonto Prüfbericht loaded successfully')
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : 'Failed to load Skonto data'
      setError(errorMessage)
      toast.error(errorMessage)
    } finally {
      setLoading(false)
    }
  }

  // Helper functions
  const formatCurrency = (amount: number | undefined): string => {
    if (!amount) return '€0.00'
    return new Intl.NumberFormat('de-DE', {
      style: 'currency',
      currency: 'EUR'
    }).format(amount)
  }

  const formatDate = (dateString: string | undefined): string => {
    if (!dateString) return 'N/A'
    return new Date(dateString).toLocaleDateString('de-DE')
  }

  const getSkontoStatusColor = (skontoDecision: string | undefined): string => {
    switch (skontoDecision) {
      case 'taken': return 'bg-green-100 text-green-800'
      case 'missed': return 'bg-red-100 text-red-800'
      case 'pending': return 'bg-yellow-100 text-yellow-800'
      case 'not_applicable': return 'bg-gray-100 text-gray-800'
      default: return 'bg-gray-100 text-gray-800'
    }
  }

  const getSkontoStatusLabel = (skontoDecision: string | undefined): string => {
    switch (skontoDecision) {
      case 'taken': return 'Skonto Taken'
      case 'missed': return 'Skonto Missed'
      case 'pending': return 'Skonto Pending'
      case 'not_applicable': return 'No Skonto'
      default: return 'Unknown'
    }
  }

  const getSkontoUrgencyColor = (daysUntilSkonto: number | undefined): string => {
    if (daysUntilSkonto === undefined) return 'bg-gray-100 text-gray-800'
    if (daysUntilSkonto < 0) return 'bg-red-100 text-red-800' // Expired
    if (daysUntilSkonto <= 3) return 'bg-red-100 text-red-800' // Critical
    if (daysUntilSkonto <= 7) return 'bg-yellow-100 text-yellow-800' // Warning
    return 'bg-green-100 text-green-800' // Safe
  }

  const calculatePotentialSavings = (amount: number | undefined, percentage: number | undefined): number => {
    if (!amount || !percentage) return 0
    return (amount * percentage) / 100
  }

  const calculateUtilizationRate = (): number => {
    if (!skontoMetrics) return 0
    return skontoMetrics.skonto_utilization_rate || 0
  }

  // Skonto action functions
  const sendSkontoReminder = async (invoiceId: string, invoiceNumber: string) => {
    // Show confirmation dialog in German
    const confirmed = window.confirm(
      `Skonto-Erinnerung senden?\n\nMöchten Sie wirklich eine Skonto-Erinnerung für die Rechnung "${invoiceNumber}" senden?\n\nKlicken Sie "OK" zum Bestätigen oder "Abbrechen" zum Abbrechen.`
    )
    
    if (!confirmed) {
      return
    }

    try {
      // Use the working Skonto test reminder endpoint
      const response = await fetch(`${apiUrl}/api/skonto/test/send-reminder/${invoiceId}?recipient_email=finance@company.com`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })

      if (!response.ok) {
        throw new Error(`Failed to send Skonto reminder: ${response.statusText}`)
      }

      const result = await response.json()
      
      if (result.success) {
        toast.success(`📧 Skonto-Erinnerung erfolgreich gesendet!`)
        fetchSkontoData() // Refresh data
      } else {
        toast.error(`❌ Fehler beim Senden der Skonto-Erinnerung: ${result.message || 'Unbekannter Fehler'}`)
      }
    } catch (err) {
      console.error('Error sending Skonto reminder:', err)
      toast.error(`Fehler beim Senden der Skonto-Erinnerung: ${err instanceof Error ? err.message : 'Unbekannter Fehler'}`)
    }
  }

  const markSkontoDecision = async (invoiceId: string, decision: 'taken' | 'missed', invoiceNumber: string, potentialSavings: number) => {
    // Show confirmation dialog in German
    const decisionText = decision === 'taken' ? 'genommen' : 'verpasst'
    const savingsText = decision === 'taken' 
      ? `Sie sparen ${formatCurrency(potentialSavings)}.` 
      : `Sie verpassen Einsparungen von ${formatCurrency(potentialSavings)}.`
    
    const confirmed = window.confirm(
      `Skonto-Entscheidung bestätigen?\n\nRechnung: ${invoiceNumber}\nSkonto als "${decisionText}" markieren?\n${savingsText}\n\nKlicken Sie "OK" zum Bestätigen oder "Abbrechen" zum Abbrechen.`
    )
    
    if (!confirmed) {
      return
    }

    try {
      // Use the direct invoice update endpoint
      const response = await fetch(`${apiUrl}/api/invoices/${invoiceId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          skonto_decision: decision,
          actual_skonto_savings: decision === 'taken' ? potentialSavings : 0
        })
      })

      if (!response.ok) {
        throw new Error(`Failed to update Skonto decision: ${response.statusText}`)
      }

      const result = await response.json()
      
      if (result.success) {
        const successText = decision === 'taken' 
          ? `✅ Skonto als genommen markiert - ${formatCurrency(potentialSavings)} gespart!`
          : `❌ Skonto als verpasst markiert`
        toast.success(successText)
        fetchSkontoData() // Refresh data
      } else {
        toast.error(`❌ Fehler beim Aktualisieren der Skonto-Entscheidung: ${result.error || 'Unbekannter Fehler'}`)
      }
    } catch (err) {
      console.error('Error updating Skonto decision:', err)
      toast.error(`Fehler beim Aktualisieren der Skonto-Entscheidung: ${err instanceof Error ? err.message : 'Unbekannter Fehler'}`)
    }
  }

  if (loading) {
    return (
      <div className="min-h-screen py-8 px-4 relative">
        <div className="max-w-7xl mx-auto relative z-10">
          <div className="glass-card rounded-2xl p-12 shadow-2xl">
            <div className="flex justify-center items-center">
              <div className="animate-spin rounded-full h-16 w-16 border-4 border-blue-600 border-t-transparent"></div>
              <span className="ml-4 text-xl text-gray-700 font-medium">Loading Skonto Analytics...</span>
            </div>
          </div>
        </div>
      </div>
    )
  }

  if (error) {
    return (
      <div className="min-h-screen py-8 px-4 relative">
        <div className="max-w-7xl mx-auto relative z-10">
          <div className="glass-card rounded-2xl p-8 shadow-2xl border-red-200">
            <div className="flex items-start">
              <div className="flex-shrink-0">
                <div className="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                  <svg className="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.268 16.5c-.77.833.192 2.5 1.732 2.5z" />
                  </svg>
                </div>
              </div>
              <div className="ml-4">
                <h3 className="text-lg font-medium text-red-800 mb-2">Error Loading Skonto Prüfbericht</h3>
                <div className="text-red-700 mb-4">
                  <p>{error}</p>
                </div>
                <button
                  onClick={fetchSkontoData}
                  className="glass bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg text-sm font-medium transition-all duration-200 shadow-lg hover:shadow-xl hover:scale-105"
                >
                  🔄 Retry Loading
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    )
  }

  return (
    <div className="min-h-screen py-8 px-4 relative">
      <Toaster {...toastConfig} />
      
      {/* Floating Background Elements */}
      <div className="fixed inset-0 pointer-events-none overflow-hidden">
        <div className="absolute top-1/4 left-1/4 w-64 h-64 bg-gradient-to-r from-blue-400 to-purple-400 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-float"></div>
        <div className="absolute top-3/4 right-1/4 w-64 h-64 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-float" style={{animationDelay: '2s'}}></div>
        <div className="absolute top-1/2 right-1/3 w-64 h-64 bg-gradient-to-r from-green-400 to-blue-400 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-float" style={{animationDelay: '4s'}}></div>
      </div>
      
      <div className="max-w-7xl mx-auto relative z-10">
      
      {/* Header */}
      <div className="mb-8">
        <div className="flex items-center justify-between">
          <div>
            <h1 className="text-3xl font-bold text-gray-900 mb-2">� Skonto Prüfbericht - Discount Analytics Dashboard</h1>
            <p className="text-gray-600">Monitor and optimize early payment discount opportunities</p>
          </div>
          
          {/* Time Range Filter */}
          <div className="flex space-x-2">
            {(['7d', '30d', '90d', 'all'] as const).map((range) => (
              <button
                key={range}
                onClick={() => setSelectedTimeRange(range)}
                className={`px-4 py-2 rounded-md text-sm font-medium transition-colors ${
                  selectedTimeRange === range
                    ? 'bg-blue-600 text-white'
                    : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                }`}
              >
                {range === 'all' ? 'All Time' : range.toUpperCase()}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Skonto Key Metrics */}
      {skontoMetrics && (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          
          {/* Total Potential Savings */}
          <div className="bg-blue-50 border border-blue-200 rounded-lg p-6">
            <div className="flex items-center justify-between">
              <div>
                <div className="text-2xl font-bold text-blue-700">{formatCurrency(skontoMetrics.total_potential_savings)}</div>
                <div className="text-sm text-blue-600">Total Potential Savings</div>
                <div className="text-xs text-blue-500 mt-1">{skontoMetrics.total_invoices_with_skonto} invoices with Skonto</div>
              </div>
              <div className="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                <svg className="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
                </svg>
              </div>
            </div>
          </div>

          {/* Actual Savings (Taken) */}
          <div className="bg-green-50 border border-green-200 rounded-lg p-6">
            <div className="flex items-center justify-between">
              <div>
                <div className="text-2xl font-bold text-green-700">{formatCurrency(skontoMetrics.total_actual_savings)}</div>
                <div className="text-sm text-green-600">Savings Realized</div>
                <div className="text-xs text-green-500 mt-1">
                  {Math.round(calculateUtilizationRate())}% utilization rate
                </div>
              </div>
              <div className="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                <svg className="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
          </div>

          {/* Missed Savings */}
          <div className="bg-red-50 border border-red-200 rounded-lg p-6">
            <div className="flex items-center justify-between">
              <div>
                <div className="text-2xl font-bold text-red-700">{formatCurrency(skontoMetrics.total_missed_savings)}</div>
                <div className="text-sm text-red-600">Savings Missed</div>
                <div className="text-xs text-red-500 mt-1">Opportunities lost</div>
              </div>
              <div className="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                <svg className="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                </svg>
              </div>
            </div>
          </div>

          {/* Upcoming Opportunities */}
          <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
            <div className="flex items-center justify-between">
              <div>
                <div className="text-2xl font-bold text-yellow-700">{skontoMetrics.upcoming_skonto_count}</div>
                <div className="text-sm text-yellow-600">Upcoming Opportunities</div>
                <div className="text-xs text-yellow-500 mt-1">{formatCurrency(skontoMetrics.upcoming_skonto_value)} potential</div>
              </div>
              <div className="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                <svg className="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
          </div>

        </div>
      )}

      {/* Skonto Status Breakdown */}
      {skontoStats && (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          
          {/* Pending Skontos */}
          <div className="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold text-gray-900">⏳ Pending</h3>
              <span className="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                {skontoStats.pending.count}
              </span>
            </div>
            <div className="space-y-2">
              <div className="text-2xl font-bold text-gray-900">{formatCurrency(skontoStats.pending.potential_savings)}</div>
              <div className="text-sm text-gray-600">Potential savings</div>
              <div className="text-xs text-gray-500">Total value: {formatCurrency(skontoStats.pending.total_amount)}</div>
            </div>
          </div>

          {/* Taken Skontos */}
          <div className="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold text-gray-900">✅ Taken</h3>
              <span className="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                {skontoStats.taken.count}
              </span>
            </div>
            <div className="space-y-2">
              <div className="text-2xl font-bold text-green-600">{formatCurrency(skontoStats.taken.actual_savings)}</div>
              <div className="text-sm text-gray-600">Savings realized</div>
              <div className="text-xs text-gray-500">Total value: {formatCurrency(skontoStats.taken.total_amount)}</div>
            </div>
          </div>

          {/* Missed Skontos */}
          <div className="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold text-gray-900">❌ Missed</h3>
              <span className="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                {skontoStats.missed.count}
              </span>
            </div>
            <div className="space-y-2">
              <div className="text-2xl font-bold text-red-600">{formatCurrency(skontoStats.missed.missed_savings)}</div>
              <div className="text-sm text-gray-600">Savings lost</div>
              <div className="text-xs text-gray-500">Total value: {formatCurrency(skontoStats.missed.total_amount)}</div>
            </div>
          </div>

          {/* Expiring Soon */}
          <div className="bg-white border border-orange-200 rounded-lg p-6 hover:shadow-md transition-shadow">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold text-gray-900">🚨 Expiring</h3>
              <span className="bg-orange-100 text-orange-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                {skontoStats.expiring_soon.count}
              </span>
            </div>
            <div className="space-y-2">
              <div className="text-2xl font-bold text-orange-600">{formatCurrency(skontoStats.expiring_soon.potential_savings)}</div>
              <div className="text-sm text-gray-600">At risk savings</div>
              <div className="text-xs text-gray-500">Total value: {formatCurrency(skontoStats.expiring_soon.total_amount)}</div>
            </div>
          </div>

        </div>
      )}

      {/* Skonto Invoices Table */}
      <div className="bg-white rounded-lg shadow-sm border border-gray-100">
        <div className="p-6 border-b border-gray-100">
          <div className="flex items-center justify-between">
            <h2 className="text-xl font-semibold text-gray-900">Skonto Invoice Management</h2>
            <div className="text-sm text-gray-500">
              {skontoInvoices.filter(inv => inv.skonto_decision === 'pending').length} pending decisions
            </div>
          </div>
        </div>
        
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vendor</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Skonto Details</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Potential Savings</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {skontoInvoices.map((invoice) => (
                <tr key={invoice.id} className="hover:bg-gray-50">
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-gray-900">{invoice.filename}</div>
                    <div className="text-sm text-gray-500">
                      {formatDate(invoice.invoice_date)}
                    </div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm text-gray-900">{invoice.vendor_name || 'N/A'}</div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-gray-900">
                      {formatCurrency(invoice.total_amount)}
                    </div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm text-gray-900">{invoice.skonto_percentage}% discount</div>
                    <div className="text-xs text-gray-500">Until {formatDate(invoice.skonto_date)}</div>
                    {invoice.days_until_skonto !== undefined && (
                      <div className={`text-xs mt-1 font-medium ${
                        invoice.days_until_skonto < 0 ? 'text-red-600' :
                        invoice.days_until_skonto <= 3 ? 'text-red-600' :
                        invoice.days_until_skonto <= 7 ? 'text-yellow-600' : 'text-green-600'
                      }`}>
                        {invoice.days_until_skonto < 0 ? 'EXPIRED' : `${invoice.days_until_skonto} days left`}
                      </div>
                    )}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm font-medium text-green-600">
                      {formatCurrency(calculatePotentialSavings(invoice.total_amount, invoice.skonto_percentage))}
                    </div>
                    {invoice.actual_skonto_savings && (
                      <div className="text-xs text-green-600 mt-1">
                        Saved: {formatCurrency(invoice.actual_skonto_savings)}
                      </div>
                    )}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className={`px-2 py-1 text-xs font-medium rounded-full ${getSkontoStatusColor(invoice.skonto_decision)}`}>
                      {getSkontoStatusLabel(invoice.skonto_decision)}
                    </span>
                    {invoice.skonto_reminder_sent && (
                      <div className="text-xs text-blue-600 mt-1">
                        📧 Reminder sent
                      </div>
                    )}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                    
                    {/* Skonto Decision Buttons */}
                    {invoice.skonto_decision === 'pending' && (
                      <>
                        <button
                          onClick={() => markSkontoDecision(
                            invoice.id, 
                            'taken', 
                            invoice.filename, 
                            invoice.potential_skonto_savings || calculatePotentialSavings(invoice.total_amount, invoice.skonto_percentage)
                          )}
                          className="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-xs"
                          title="Skonto als genommen markieren - Bestätigen erforderlich"
                        >
                          ✅ Genommen
                        </button>
                        <button
                          onClick={() => markSkontoDecision(
                            invoice.id, 
                            'missed', 
                            invoice.filename, 
                            invoice.potential_skonto_savings || calculatePotentialSavings(invoice.total_amount, invoice.skonto_percentage)
                          )}
                          className="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-xs"
                          title="Skonto als verpasst markieren - Bestätigen erforderlich"
                        >
                          ❌ Verpasst
                        </button>
                      </>
                    )}
                    
                    {/* Skonto Reminder Button */}
                    {invoice.skonto_decision === 'pending' && 
                     !invoice.skonto_reminder_sent && 
                     invoice.days_until_skonto !== undefined && 
                     invoice.days_until_skonto >= 0 && 
                     invoice.days_until_skonto <= 7 && (
                      <button
                        onClick={() => sendSkontoReminder(invoice.id, invoice.filename)}
                        className="bg-yellow-600 hover:bg-yellow-700 text-white px-3 py-1 rounded text-xs"
                        title={`Skonto-Erinnerung senden - ${invoice.days_until_skonto} Tage bis Ablauf - Bestätigen erforderlich`}
                      >
                        📧 Erinnern
                      </button>
                    )}
                    
                    <Link
                      href={`/dashboard/${invoice.id}`}
                      className="text-blue-600 hover:text-blue-900 text-xs"
                    >
                      View Details
                    </Link>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        
        {skontoInvoices.length === 0 && (
          <div className="text-center py-12">
            <svg className="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <h3 className="mt-2 text-sm font-medium text-gray-900">No Skonto invoices found</h3>
            <p className="mt-1 text-sm text-gray-500">
              No invoices with early payment discounts available for the selected time period.
            </p>
          </div>
        )}
      </div>
      </div>
    </div>
  )
}
