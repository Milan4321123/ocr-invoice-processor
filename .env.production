# Copy this file to .env and fill in your actual values

# Database Configuration - Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Email Service Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME=Invoice Management System

# Security
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production

# Application Settings
DEBUG=false
BASE_URL=http://localhost:8000
SKONTO_DEFAULT_RECIPIENT=admin@yourcompany.com

# OCR Configuration (Google Cloud Document AI)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
DOCUMENT_AI_PROCESSOR_VERSION=rc
ENABLE_OCR=true
USE_MOCK_OCR=false
OCR_MAX_FILE_SIZE_MB=10
OCR_REQUEST_TIMEOUT=60
OCR_MAX_RETRIES=3
OCR_RETRY_DELAY=5

# Local Database (if using PostgreSQL instead of Supabase)
POSTGRES_DB=ocr_invoices
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Production Settings
NODE_ENV=production
