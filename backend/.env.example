# Database Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Email Service Configuration (choose one method)
# Method 1: SendGrid (Recommended for production)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Method 2: SMTP (Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Email Settings
FROM_EMAIL=noreply@company.com
FROM_NAME=Invoice Management System
BASE_URL=http://localhost:8001

# Security
JWT_SECRET=your-secure-jwt-secret-for-approval-tokens

# Skonto Reminder Configuration
SKONTO_DEFAULT_RECIPIENT=incognizant321@gmail.com

# Optional: Debug mode
DEBUG=true
